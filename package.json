{
  "name": "claimlens-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @claimlens/engine build && pnpm --filter web build",
    "test": "node scripts/run_e2e_suite.js",
    "test:e2e": "node scripts/run_e2e_suite.js",
    "test:all": "node scripts/run_e2e_suite.js",
    "test:tiers": "node --test tests/e2e/*.test.js",
    "test:engine": "pnpm --filter @claimlens/engine test",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter @claimlens/engine typecheck && pnpm --filter web typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
